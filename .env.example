# ==================================================
# Vercel用(Next.jsアプリ本体の環境変数)
# Vercel の Project Settings > Environment Variables に設定する。
# ローカル開発では、このファイルを .env.local としてコピーして使う
# (cp .env.example .env.local)。
# VPS(LiveKitサーバー等)側の環境変数は deploy/livekit/*/.env.example を参照。
# ==================================================

# --- Supabase ---
# プロジェクトの Settings > API から取得
NEXT_PUBLIC_SUPABASE_URL=

# 新しいAPIキー方式(推奨)。Supabaseダッシュボードで新方式のキーを発行して設定する。
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# 旧キー方式(フォールバック用。新方式への切り替えが全環境で完了したら削除する)。
# 新方式のキーが設定されていればこちらは読まれない。
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- LiveKit ---
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# --- デバッグ用プラン切り替え機能(app/admin/BillingPanel.tsx)を表示してよいメールアドレス ---
DEBUG_PLAN_SWITCH_EMAIL=

# --- Cloudflare Turnstile(ログイン・新規登録・パスワード再設定のボット判定。公開してよい値) ---
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# --- Stripe ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID_LIGHT=
STRIPE_PRICE_ID_STANDARD=
STRIPE_PRICE_ID_PRO=

# --- Vercel Cron(app/api/cron/*)の認証トークン ---
CRON_SECRET=

# --- マスター画面のサーバーリソース表示(VPS上のnode_exporter。Caddyのbasic_auth経由) ---
METRICS_URL=
METRICS_BASIC_AUTH_USER=
METRICS_BASIC_AUTH_PASSWORD=
