# ==================================================
# Vercel用(Next.jsアプリ本体の環境変数)
# Vercel の Project Settings > Environment Variables に設定する。
# ローカル開発では、このファイルを .env.local としてコピーして使う
# (cp .env.example .env.local)。
# VPS(LiveKitサーバー等)側の環境変数は deploy/livekit/*/.env.example を参照。
# ==================================================

# --- Supabase ---
# プロジェクトの Settings > API から取得
NEXT_PUBLIC_SUPABASE_URL=

# 新しいAPIキー方式(推奨)。Supabaseダッシュボードで新方式のキーを発行して設定する。
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# 旧キー方式(フォールバック用。新方式への切り替えが全環境で完了したら削除する)。
# 新方式のキーが設定されていればこちらは読まれない。
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- LiveKit ---
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# --- デバッグ用プラン切り替え機能(app/admin/BillingPanel.tsx)を表示してよいメールアドレス ---
DEBUG_PLAN_SWITCH_EMAIL=

# --- Cloudflare Turnstile(ログイン・新規登録・パスワード再設定のボット判定。公開してよい値) ---
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# --- Stripe ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID_LIGHT=
STRIPE_PRICE_ID_STANDARD=
STRIPE_PRICE_ID_PRO=

# 適格請求書用の消費税率(Stripeダッシュボードで作成したinclusive・10%の
# Tax RateのID。txr_...)
STRIPE_TAX_RATE_ID=

# --- Vercel Cron(app/api/cron/*)の認証トークン ---
CRON_SECRET=

# --- マスター画面のサーバーリソース表示(VPS上のnode_exporter。Caddyのbasic_auth経由) ---
METRICS_URL=
METRICS_BASIC_AUTH_USER=
METRICS_BASIC_AUTH_PASSWORD=

# --- IndigoPro位置情報WSサーバー(deploy/indigo-position-ws/、2026-11追加) ---
# 未設定のままなら位置情報配信は従来通りSupabase Realtimeのまま(lib/
# positionTransport.ts参照)。ローカルで試すだけなら npm run dev:indigo が
# これらを自動生成するため、このファイルに手で値を入れる必要はない。
NEXT_PUBLIC_POSITION_TRANSPORT=
# indigoモードのmove送信間隔(ms)。未設定なら100ms(10回/秒)。
NEXT_PUBLIC_MOVE_SEND_INTERVAL_MS=
# WSサーバー(deploy/indigo-position-ws/)のINDIGO_WS_SECRET/KIDと同じ値にする
INDIGO_WS_SECRET=
INDIGO_WS_KID=
# クライアントが接続する公開WSSエンドポイント(例: wss://position-ws.example.com)
INDIGO_WS_URL=
# WSサーバーの管理API(/internal/disconnect)。強制退出時の接続切断に使う。
# 未設定ならこの連携は何もしない(app/admin/actions.ts・lib/broadcastForceLeave.ts)
INDIGO_WS_ADMIN_URL=
INDIGO_WS_ADMIN_SECRET=
