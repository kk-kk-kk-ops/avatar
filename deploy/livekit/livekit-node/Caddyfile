{$LIVEKIT_DOMAIN} {
  reverse_proxy localhost:7880
}

# マスター画面のサーバーリソース表示用。node_exporterの/metricsは
# サーバー情報を含むため、Basic認証で保護してから公開する。
# ハッシュ生成: docker run --rm caddy:2-alpine caddy hash-password --plaintext '<パスワード>'
{$METRICS_DOMAIN} {
  basic_auth {
    {$METRICS_BASIC_AUTH_USER} {$METRICS_BASIC_AUTH_HASH}
  }
  reverse_proxy localhost:9100
}

# アバター位置情報WSサーバー(deploy/indigo-position-ws/、2026-11追加)。
# 同じVPS上でLiveKitと同居させるため、専用のCaddyコンテナを別途立てずに
# このCaddyへ追記する(1台のVPSでポート80/443を奪い合わないため)。
{$INDIGO_WS_DOMAIN} {
  reverse_proxy localhost:{$INDIGO_WS_PORT}
}

# /internal/disconnect(Next.js専用の管理API)。公開ドメインではあるが、
# 推測困難なサブドメインに置き、実際の防御はHMAC署名+タイムスタンプ
# (indigo-position-ws側)で行う(2026-11設計レビュー: Vercelの送信元IPが
# 固定できないため、IP制限ではなくシークレットベースの認証を主とする方針)。
{$INDIGO_WS_ADMIN_DOMAIN} {
  reverse_proxy localhost:{$INDIGO_WS_ADMIN_PORT}
}
