# VPS用: indigo-position-ws/Caddyの環境変数

# --- サーバー起動モード ---
# "production" または "loadtest"。本番VPSでは必ず"production"のままにする。
SERVER_MODE=production

# --- 認証(本番) ---
# Next.jsのトークン発行APIと共有する署名シークレット(32byte以上のランダム値推奨)。
INDIGO_WS_SECRET=
INDIGO_WS_KID=production

# --- 認証(負荷試験用、SERVER_MODE=loadtestの専用インスタンスでのみ設定) ---
INDIGO_WS_TEST_SECRET=
INDIGO_WS_TEST_KID=loadtest

# --- 管理API(/internal/disconnect)の認証シークレット ---
INDIGO_WS_ADMIN_SECRET=

# --- ポート(network_mode: hostのためVPS上で直接listenする) ---
# 本番(LiveKitと同居)構成では、この2つの値と同じ番号を、既存LiveKit
# ノードの.env側のINDIGO_WS_PORT/INDIGO_WS_ADMIN_PORTにも設定すること
# (そちら側のCaddyがこのポートへリバースプロキシするため)。
WS_PORT=8787
ADMIN_PORT=8788

# --- Caddy用ドメイン(スタンドアロン運用時のみ。docker-compose.standalone.yml参照) ---
# 本番(LiveKitと同居)構成ではここは使わず、代わりに既存LiveKitノードの
# .envにINDIGO_WS_DOMAIN/INDIGO_WS_ADMIN_DOMAINを設定する(README.md
# 「デプロイ手順」参照)。
INDIGO_WS_DOMAIN=position-ws.yourdomain.com
# 推測困難なサブドメインにする(公開リンクには載せない運用を想定)。
INDIGO_WS_ADMIN_DOMAIN=position-ws-admin.yourdomain.com

# --- 配信方式(任意、未設定ならimmediate) ---
# RELAY_MODE=immediate
# TICK_INTERVAL_MS=50

# 他の調整可能なパラメータ(送信頻度上限・速度閾値等)はconfig.mjs参照。
# 必要な場合のみ同名の環境変数で上書きする。
